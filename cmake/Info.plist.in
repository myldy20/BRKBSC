<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key><string>io.github.myldy20.brkbsc</string>
    <key>CFBundleName</key><string>BRKBSC</string>
    <key>CFBundleShortVersionString</key><string>${PROJECT_VERSION}</string>
    <key>CFBundleVersion</key><string>${PROJECT_VERSION}</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSMicrophoneUsageDescription</key><string>BRKBSC listens to your voice or instrument to create accompaniment and live soundscapes.</string>
</dict>
</plist>
